# LIFE DUEL — configuración del servidor
# Copia este archivo a .env y completa los valores necesarios.
# El juego funciona en local sin PostgreSQL y sin DeepSeek.

NODE_ENV=development
PORT=4000
# Orígenes permitidos por CORS, separados por comas. En producción incluye
# la URL pública (https://...). Render añade RENDER_EXTERNAL_URL solo.
CLIENT_ORIGIN=http://localhost:5173

# Secreto de firma de sesiones anónimas. Obligatorio en producción.
# Genera uno con: openssl rand -hex 48
# Si no se define en desarrollo, se crea server/.data/.session-secret (0600)
# para que las sesiones sobrevivan a reinicios. No se versiona.
# SESSION_SECRET=

# Persistencia: json (por defecto, sin dependencias externas) o postgres.
PERSISTENCE=json
# DATABASE_URL=postgresql://life_duel:life_duel@localhost:5432/life_duel?schema=public
# Solo se persisten salas de duelo; las vidas individuales viven en memoria.
# Con REQUIRE_DATABASE=1 el arranque falla si PostgreSQL no responde. Sin ella,
# el servidor continúa en modo memoria y lo avisa en /api/health.
# REQUIRE_DATABASE=1

# Rutas opcionales (por defecto data/ y server/.data/)
# DATA_DIR=./data
# PERSIST_DIR=./server/.data

# DeepSeek es opcional. Sin clave, el juego usa textos locales.
# DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=9000

LOG_LEVEL=info
# 1 detrás de Render, nginx u otro proxy inverso.
# TRUST_PROXY=0
